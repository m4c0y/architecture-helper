__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
# saídas são regeneráveis a partir do YAML
projetos/*/saidas/*
!projetos/*/saidas/.gitkeep
projetos/*/propostas/*/saidas/
.idea/

# dados pessoais do usuário (não versionar no repositório público)
projetos/apartamento/
projetos/apartamento-reforma/

# texturas baixadas (CC0, regeneráveis com catalogo/texturas/baixar.py)
catalogo/texturas/*/
